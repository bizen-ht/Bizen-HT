rules_version = '2';

/* ============================================================
   BIZEN HT — Règles de sécurité Firestore
   But : aucune fuite de données, aucune écriture non autorisée.
   À déployer dans : Firebase Console > Firestore Database > Règles
   (voir SECURITE-DEPLOIEMENT.md)
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* L'administrateur (toi) est identifié par son e-mail unique. */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "bizenht@gmail.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* Le compte de l'appelant n'est PAS gelé (sanction). Un compte gelé ne peut
       plus créer de réservation. (Le doc peut ne pas exister au tout 1er instant.) */
    function notFrozen() {
      return isSignedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "frozen");
    }

    /* -------- PROFIL PRIVÉ (users) : le propriétaire uniquement --------
       Contient e-mail, téléphone, date de naissance => JAMAIS public. */
    match /users/{userId} {
      allow read:   if isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (isSignedIn() && resource.data.bossId == request.auth.uid);   /* le Boss lit ses Elu */
      allow create: if isSignedIn() && request.auth.uid == userId;
      /* Le propriétaire peut éditer son profil, MAIS jamais son solde wallet :
         l'argent ne bouge que via le serveur (webhook / wallet-pay / wallet-refund
         en Admin SDK, qui contourne les règles) ou l'admin. */
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'solde']));
      allow delete: if isAdmin();
    }

    /* -------- PROFIL PUBLIC (publicProfiles) : catalogue --------
       Pas d'e-mail/téléphone ici. Lecture publique (catalogue + QR).
       Écriture seulement par le propriétaire ou l'admin. */
    match /publicProfiles/{userId} {
      allow read:  if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    /* -------- RÉSERVATIONS : client + Elu concernés + admin --------
       userId = client, prestateId = Elu. Personne d'autre ne peut lire. */
    match /reservations/{resId} {
      allow read:   if isAdmin()
        || (isSignedIn() && (resource.data.userId == request.auth.uid
                          || resource.data.prestateId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && notFrozen();
      allow update: if isAdmin()
        || (isSignedIn() && (resource.data.userId == request.auth.uid
                          || resource.data.prestateId == request.auth.uid));
      allow delete: if isAdmin();
    }

    /* -------- PAIEMENTS : le propriétaire + admin uniquement -------- */
    match /payments/{payId} {
      allow read:   if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    /* -------- NOTES / ÉTOILES (ratings) : lecture publique --------
       Servent à calculer la moyenne affichée sur le catalogue.
       Créables par un utilisateur connecté ; non modifiables ensuite. */
    match /ratings/{ratingId} {
      allow read:   if true;
      /* Le VIP crée SA note (userId = lui). L'admin peut aussi créer (notes admin). */
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      /* Le VIP peut METTRE À JOUR sa propre note (doc id = reservationId => .set()
         idempotent, il peut re-noter/corriger). L'admin peut tout. */
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    /* -------- AVIS GLOBAUX DU SITE (siteReviews) --------
       Public : ne voit QUE les avis approuvés.
       Un utilisateur connecté peut en créer un, forcément "pending"
       (il ne peut pas s'auto-approuver). Seul l'admin approuve/supprime. */
    match /siteReviews/{reviewId} {
      allow read: if isAdmin()
        || (resource != null && resource.data.status == "approved");
      allow create: if isSignedIn()
        && request.resource.data.status == "pending"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    /* -------- NOTIFICATIONS ADMIN (adminNotifs) — optionnel --------
       Réservé à l'admin. */
    match /adminNotifs/{notifId} {
      allow read, write: if isAdmin();
    }

    /* -------- HOTELS PARTENAIRES (hotels) --------
       Gérés manuellement par l'admin. Lecture publique : la page de
       réservation affiche la liste des hôtels de la zone choisie. */
    match /hotels/{hotelId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* -------- MESSAGERIE DE DÉCOUVERTE (DM avant réservation) --------
       Threads + messages. L'ÉCRITURE passe UNIQUEMENT par la fonction
       Netlify dm-send (Admin SDK) => anti-triche sur les limites + filtrage.
       Le client ne fait que LIRE ses propres fils/messages. */
    match /dmThreads/{threadId} {
      /* Lecture alignée sur les champs filtrables (requêtes par userUid / eluUid) */
      allow read:   if isAdmin()
        || (isSignedIn() && (resource.data.userUid == request.auth.uid
                          || resource.data.eluUid == request.auth.uid));
      allow create, delete: if isAdmin();   /* créé par la fonction (Admin SDK) */
      /* Un participant peut SEULEMENT remettre à zéro ses compteurs de non-lus. */
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadForElu', 'unreadForUser']));
    }
    match /dmMessages/{msgId} {
      /* Lu via une requête where("participants","array-contains",uid) => rule-safe */
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow write: if isAdmin();   /* écrit par la fonction (Admin SDK) */
    }
    /* Compteurs journaliers : strictement serveur (anti-triche). */
    match /dmCounters/{counterId} {
      allow read, write: if isAdmin();
    }

    /* Historique des diffusions marketing : admin uniquement. */
    match /broadcasts/{bId} {
      allow read, write: if isAdmin();
    }

    /* -------- AGENCES PARTENAIRES (agencies) --------
       Config publique (nom, slug, bossUid, icône) : lisible par tous pour
       afficher la case à l'inscription, le badge, et la page dédiée.
       Créées/gérées par l'admin uniquement. */
    match /agencies/{slug} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* Paramètres publics (ex: offre Premium à rabais) : lecture publique
       (le site affiche la bannière), écriture admin uniquement. */
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* -------- LISTE D'ATTENTE DIASPORA (diasporaWaitlist) --------
       N'importe quel visiteur (même non connecté) peut s'inscrire avec
       son pays + WhatsApp. Lecture/gestion réservées à l'admin. */
    match /diasporaWaitlist/{entryId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() > 0
        && request.resource.data.whatsapp.size() <= 40
        && request.resource.data.status == "new";
    }

    /* -------- CHAT SÉCURISÉ : seulement les 2 participants -------- */
    match /chats/{resId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.participants);

      match /messages/{msgId} {
        allow read, create, update, delete: if isAdmin()
          || (isSignedIn() && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(resId)).data.participants);
      }
    }

    /* -------- AFFILIATION : codes promo --------
       Créés manuellement par l'admin. Le propriétaire lit SON code (par e-mail). */
    match /promoCodes/{codeId} {
      allow read:  if isAdmin()
        || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow write: if isAdmin();
    }

    /* -------- AFFILIATION : transactions (commissions gagnées) --------
       Écrites par l'admin à la confirmation du paiement. L'affilié lit les siennes. */
    match /affiliateTransactions/{txId} {
      allow read:   if isAdmin()
        || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    /* -------- AFFILIATION : demandes de retrait --------
       L'affilié crée sa demande (à son nom, statut "pending"). Admin traite. */
    match /affiliateWithdrawals/{wId} {
      allow read:   if isAdmin()
        || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow create: if isSignedIn()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    /* -------- ANBASADÈ : recrutement d'Elus (chaîne de récompenses) --------
       Créés manuellement par l'admin, liés au compte Bizen (email) de l'ambassadeur.
       Le propriétaire lit SON doc (par email). Le comptage des Elus recrutés se
       fait via publicProfiles (déjà public), pas ici. */
    match /ambassadors/{code} {
      allow read:  if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow write: if isAdmin();   /* auto-activation via la fonction ambassador (Admin SDK) */
    }

    /* -------- ANBASADÈ : demandes de prime ("touche") --------
       Créées par la fonction ambassador (Admin SDK) quand l'ambassadeur touche
       une prime. Le propriétaire lit les siennes ; l'admin les paie. */
    match /ambassadorPayouts/{id} {
      allow read:  if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    /* -------- VUES DE PROFIL (profileViews) : "qui a vu ton profil" --------
       Écrites UNIQUEMENT par la fonction profile-view (Admin SDK) quand un VIP
       Premium ouvre un profil. L'Elu concerné lit SES visites et peut seulement
       les marquer comme "vues" (seenByElu) — rien d'autre. */
    match /profileViews/{viewId} {
      allow read:   if isAdmin()
        || (isSignedIn() && resource.data.eluUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.eluUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByElu']));
    }

    /* -------- DEMANDES VIP (vipDemands) : "Post yon demann" --------
       Un VIP Premium publie une demande ciblée par zone ; les Elus la voient.
       Écriture UNIQUEMENT via la fonction demand (Admin SDK) — vérifie Premium,
       filtre les coordonnées, impose 1 active + expiration. Lecture par tout
       utilisateur connecté (contient un pseudo, pas de vrai nom). */
    match /vipDemands/{demandId} {
      allow read:  if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /* -------- STORIES DES ELU (stories) --------
       L'Elu poste ses propres stories (texte+emoji ou photo+caption).
       Tous les utilisateurs connectés les voient. Les compteurs
       (vues/likes/commentaires) sont écrits UNIQUEMENT par la fonction story
       (Admin SDK) — un viewer ne peut pas modifier le doc. L'Elu (ou l'admin)
       peut supprimer sa story. */
    match /stories/{storyId} {
      allow read:   if isSignedIn();
      allow create, update: if isAdmin();   /* créé/compté par la fonction story (Admin SDK) */
      allow delete: if isAdmin() || (isSignedIn() && resource.data.eluUid == request.auth.uid);
    }

    /* -------- ESPAS BYENNÈT (articles édukatif) --------
       Lecture publique des articles PUBLIÉS (pas besoin d'être connecté — bon
       pour le SEO). L'admin lit tout (y compris brouillons) et écrit. */
    match /articles/{id} {
      allow read:  if isAdmin() || (resource != null && resource.data.published == true);
      allow write: if isAdmin();
    }

    /* -------- PAIEMENTS NATCASH MANUELS (natcashPayments) --------
       Écrits UNIQUEMENT par les fonctions natcash-submit / natcash-verify
       (Admin SDK). Le doc id = Transaction ID => unicité garantie. Le client
       lit ses propres soumissions ; l'admin lit tout. */
    match /natcashPayments/{txId} {
      allow read:  if isAdmin()
        || (isSignedIn() && resource.data.submittedByUid == request.auth.uid);
      allow write: if isAdmin();
    }

    /* ============================================================
       BIZEN SOCIAL — app de rencontres (séparée du système Élu)
       Principe identique au reste du site : le client LIT, mais toute
       écriture sensible (swipe, match, message, droits, compteurs) passe
       par les fonctions Netlify (Admin SDK), jamais en direct.
       ============================================================ */

    /* Profil Social : lisible par tout membre connecté (catalogue de swipe).
       Le propriétaire édite SON profil, mais ne peut PAS s'auto-attribuer
       un statut/rôle privilégié : status & modération restent côté serveur. */
    match /socialProfiles/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      /* Le proprietaire edite son profil, MAIS ne touche pas aux champs sensibles
         (compteurs, badges admin). Il peut mettre son status a "active" (fin de
         l'onboarding) seulement s'il n'est pas banni/suspendu — jamais s'auto-bannir. */
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['boostUntil', 'activatedAt', 'uid', 'followersCount', 'followingCount', 'verified', 'ageVerified', 'featured', 'warnings', 'nsfwFlags'])
            && (
                 !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                 || (request.resource.data.status == 'active'
                     && resource.data.status != 'banned' && resource.data.status != 'suspended')
               ));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    /* Swipes : je lis seulement les MIENS (from == moi). Écriture serveur. */
    match /socialSwipes/{id} {
      allow read:  if isAdmin() || (isSignedIn() && resource.data.from == request.auth.uid);
      allow write: if isAdmin();   /* écrit par social-swipe (Admin SDK) */
    }

    /* Matchs : lisibles par les 2 participants. Écriture serveur.
       Un participant peut SEULEMENT remettre à zéro ses non-lus + régler l'éphémère. */
    match /socialMatches/{pairId} {
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.users);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.users
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'ephemeral']));
    }

    /* Messages Social : lus par les participants (query array-contains). Écriture serveur. */
    match /socialMessages/{msgId} {
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow write: if isAdmin();   /* écrit par social-message (Admin SDK) */
    }

    /* "Qui m'a liké" : je lis seulement les miens (owner == moi). Écriture serveur.
       Le contenu n'est révélé côté UI que si je suis Premium. */
    match /socialLikesReceived/{id} {
      allow read:  if isAdmin() || (isSignedIn() && resource.data.owner == request.auth.uid);
      allow write: if isAdmin();
    }

    /* Droits (premium / crédits) : je lis les miens ; l'argent/le premium
       ne s'écrit QUE côté serveur (paiement wallet/MonCash). */
    match /socialEntitlements/{uid} {
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    /* Compteurs journaliers (anti-triche) : strictement serveur. */
    match /socialCounters/{id} {
      allow read, write: if isAdmin();
    }

    /* Blocages : je lis/gère les miens (blocker == moi). Écriture serveur
       (via social-moderation) pour garantir la réciprocité et l'auto-block. */
    match /socialBlocks/{id} {
      allow read:  if isAdmin() || (isSignedIn() && resource.data.blocker == request.auth.uid);
      allow write: if isAdmin();
    }

    /* Signalements : créés via la fonction (Admin SDK). Lecture admin only. */
    match /socialReports/{id} {
      allow read, write: if isAdmin();
    }

    /* -------- FIL D'ACTUALITE (socialPosts) --------
       Posts type Instagram. Lecture par tout membre connecté. Ecriture
       (create/like/comment/delete) via la fonction social-post (Admin SDK). */
    match /socialPosts/{postId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /socialPostLikes/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /socialPostComments/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    /* Sauvegardes : je lis seulement les miennes (uid == moi). Ecriture serveur. */
    match /socialSaves/{id} {
      allow read:  if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    /* Abonnements (follow) : lisibles par les membres connectés (compter/afficher).
       Ecriture via la fonction social-follow (Admin SDK) pour compteurs fiables. */
    match /socialFollows/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    /* -------- VYOLASYON KONTAK (contactViolations) --------
       Journal des tentatives de partage de contact détectées côté serveur
       (dm-send, Admin SDK). Admin seul peut lire/gérer. */
    match /contactViolations/{vId} {
      allow read, write: if isAdmin();
    }

    /* -------- TOUT LE RESTE : interdit par défaut --------
       (Aucune collection oubliée ne reste ouverte.) */
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
